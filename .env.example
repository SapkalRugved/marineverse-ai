# PostgreSQL/PostGIS
PGHOST=localhost
PGPORT=5432
PGDATABASE=marineverse
PGUSER=postgres
PGPASSWORD=

# Live AISStream ingestion
AISSTREAM_API_KEY=

# Optional external root for marine runtime datasets
# Leave unset to use the existing repository data/ directory.
# Example Windows path: C:\MarineVerseData
MARINEVERSE_DATA_DIR=