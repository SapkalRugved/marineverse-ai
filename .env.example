# PostgreSQL/PostGIS
PGHOST=localhost
PGPORT=5432
PGDATABASE=marineverse
PGUSER=postgres
PGPASSWORD=

# Optional PostgreSQL connection settings
# Local development can leave these unset.
# Cloud: prefer verify-full with a trusted CA where supported.
# PGSSLMODE=verify-full
# PGCONNECT_TIMEOUT=10
# PGOPTIONS=-c search_path=public

# AWS staging (optional; no resources created)
# AWS_REGION=ap-south-1
# MARINEVERSE_S3_BUCKET=your-future-bucket-name

# Live AISStream ingestion
AISSTREAM_API_KEY=

# Optional external root for marine runtime datasets
# Leave unset to use the existing repository data/ directory.
# Example Windows path: C:\MarineVerseData
MARINEVERSE_DATA_DIR=