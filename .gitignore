# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Environment variables / secrets
.env
.env.*
!.env.example

# IDE / editor
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build / packaging
build/
dist/
*.egg-info/

# Local raw and processed datasets
data/raw/*
data/processed/*

# Keep main directory placeholders
!data/raw/.gitkeep
!data/processed/.gitkeep

# Keep the ports raw-data directory but ignore downloaded port datasets
!data/raw/ports/
data/raw/ports/*
!data/raw/ports/.gitkeep

# Keep the weather raw-data directory but ignore downloaded datasets
!data/raw/weather/
data/raw/weather/*
!data/raw/weather/.gitkeep

# Keep the ocean raw-data directory but ignore downloaded ocean datasets
!data/raw/ocean/
data/raw/ocean/*
!data/raw/ocean/.gitkeep

# Logs
*.log
logs/